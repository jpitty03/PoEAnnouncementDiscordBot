# Required: your bot token from the Discord Developer Portal. Keep .env private.
BOT_TOKEN=your_discord_bot_token

# Optional: defaults work for a new bot. See docs/configuration.md for all settings.
NEWS_SOURCE=rss
POLL_INTERVAL_MS=600000
FIRST_RUN_MODE=baseline

# Local Node.js storage. Docker Compose uses its persistent volume instead.
DATA_DIR=./data

# To use Steam, set NEWS_SOURCE=steam and uncomment the desired game IDs.
# PoE 1: 238960. PoE 2: 2694490. Both: 238960,2694490.
# STEAM_APP_IDS=238960

# Optional X posts require your own RSS provider, then !togglex in Discord.
# X_RSS_URL=https://your-provider.example/pathofexile/rss
