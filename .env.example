BOT_TOKEN=your_discord_bot_token

# rss: official PoE news; steam: GGG's publisher announcements through Steam's JSON API.
NEWS_SOURCE=rss
RSS_FEED_URL=https://www.pathofexile.com/news/rss
# PoE 1: 238960. PoE 2: 2694490. Both: 238960,2694490.
STEAM_APP_IDS=238960

# Optional. Supply an RSS provider for pathofexile X posts; no hardcoded Nitter instance.
X_RSS_URL=

# Relative paths are resolved against this project, regardless of the launch directory.
DATA_DIR=.
# Wait this long after a completed check before starting the next one (default: 10 minutes).
POLL_INTERVAL_MS=600000
HTTP_TIMEOUT_MS=30000
HTTP_MAX_ATTEMPTS=3
HTTP_MAX_BYTES=2097152
# baseline skips the existing feed on first use of each source; backfill sends unseen entries.
FIRST_RUN_MODE=baseline
# Keep this many completed records per source, plus current feed entries and all pending posts.
HISTORY_LIMIT=1000
